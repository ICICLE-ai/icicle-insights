<!doctype html>
<html lang="en" data-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>ICICLE Insights — Dashboard</title>
  <link href="https://cdn.jsdelivr.net/npm/daisyui@4.12.24/dist/full.min.css" rel="stylesheet" type="text/css">
  <link rel="stylesheet" href="/dashboard.css">
  <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
</head>

<body>
  <div class="wrap">

    <div class="topbar">
      <div class="brand">
        <div class="brand-mark"></div>
        <div>
          <h1>ICICLE Insights</h1>
          <p class="sub" data-summary>Loading…</p>
        </div>
      </div>
      <button class="btn btn-sm btn-ghost" type="button" data-theme-toggle>◐ Theme</button>
    </div>

    <div class="filterbar">
      <span class="flabel">Range</span>
      <div class="join">
        <button class="btn btn-sm join-item" type="button" data-range="30">30d</button>
        <button class="btn btn-sm join-item seg-active" type="button" data-range="90">90d</button>
        <button class="btn btn-sm join-item" type="button" data-range="all">All</button>
      </div>
      <span class="flabel">Account</span>
      <select class="select select-sm select-bordered" data-account aria-label="Account"></select>
      <span class="flabel">Resource</span>
      <select class="select select-sm select-bordered" data-resource aria-label="Resource"></select>
      <span class="spacer"></span>
      <button class="btn btn-sm btn-ghost" type="button" data-refresh>↻ Refresh</button>
    </div>

    <section class="section" data-section="profile" hidden>
      <div class="panel profile" data-profile></div>
    </section>

    <section class="section" data-section="kpis">
      <div class="kpi-grid" data-kpis></div>
    </section>

    <section class="section" data-section="distributions" hidden>
      <div class="section-head"><h2>Portfolio</h2><span class="hint">counts across your enums</span></div>
      <div class="mini-grid" data-distributions></div>
    </section>

    <section class="section" data-section="leaders" hidden>
      <div class="section-head"><h2>Leaders</h2><span class="hint">top resources by metric</span></div>
      <div class="mini-grid" data-leaders></div>
    </section>

    <section class="section" data-section="charts">
      <div class="section-head"><h2 data-charts-title>Metrics over time</h2><span class="hint">one chart per metric type</span></div>
      <div class="chart-grid" data-charts></div>
    </section>

    <section class="section" data-section="releases" hidden>
      <div class="section-head"><h2>Releases</h2></div>
      <div class="panel"><div class="releases" data-releases></div></div>
    </section>

  </div>

  <script src="/dashboard.js"></script>
</body>
</html>
