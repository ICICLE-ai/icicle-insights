@host=localhost:8080
@accountId=0ba5c0de-0000-0000-0000-000000000000

###

# @name createResource
POST /resources HTTP/1.1
HOST: {{host}}
Content-Type: application/json

{
    "accountID": "{{accountId}}",
    "name": "profilingcompiler",
    "type": "repository"
}

###

POST /releases HTTP/1.1
HOST: {{host}}
Content-Type: application/json

{
    "resourceID": "{{createResource.response.body.$.id}}",
    "version": "1.0",
    "month": 9,
    "year": 2024
}

###

POST /metrics HTTP/1.1
HOST: {{host}}
Content-Type: application/json

{
    "resourceID": "{{createResource.response.body.$.id}}",
    "reading": 23,
    "type": "clones"
}

###

POST /metrics HTTP/1.1
HOST: {{host}}
Content-Type: application/json

{
    "resourceID": "{{createResource.response.body.$.id}}",
    "reading": 1,
    "type": "subscribers"
}

###

POST /metrics HTTP/1.1
HOST: {{host}}
