# @name createResource
POST /resources HTTP/1.1
HOST: {{host}}
Content-Type: application/json

{
    "accountID": "{{accountId}}",
    "name": "icicle-playgrounds",
    "type": "repository"
}

###

POST /releases HTTP/1.1
HOST: {{host}}
Content-Type: application/json

{
    "resourceID": "{{createResource.response.body.$.id}}",
    "version": "0.1.5.5",
    "month": 8,
    "year": 2025
}

###

POST /metrics HTTP/1.1
HOST: {{host}}
Content-Type: application/json

