# @name createResource
POST /resources HTTP/1.1
HOST: {{host}}
Content-Type: application/json

{
    "accountID": "{{accountId}}",
    "name": "icicle_foodshed_parser",
    "type": "repository"
}

###

POST /releases HTTP/1.1
HOST: {{host}}
Content-Type: application/json

{
    "resourceID": "{{createResource.response.body.$.id}}",
    "version": "0.1",
    "month": 6,
    "year": 2023
}

###

POST /metrics HTTP/1.1
HOST: {{host}}
Content-Type: application/json

