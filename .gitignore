default.profraw

.memsearch
# Anchored: a bare `data/` also matched web/src/lib/data/ and kept the dashboard's data layer out
# of the repository.
/data/

# Dashboard build output goes to Public/ and is never committed; Docker produces it in a
# dedicated Deno stage so a host build never becomes part of the image accidentally. web/ has
# its own .gitignore for node_modules, .svelte-kit and build.
Public/*
!Public/.gitkeep

# Postgres data bind-mounted by the `just db` container recipe.
.container/

# Personal design notes and presentation drafts.
personal-notes/


# Container-side SwiftPM scratch path; a separate target platform from the host .build
.build-container/

# Server and dashboard staged by CI for the Dockerfile's `prebuilt` target. Never committed.
.ci-staging/

# Database dumps. This repository is public and a production dump carries real account data.
*.sql
