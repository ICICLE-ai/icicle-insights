# Copy to `.env` and fill in.

LOG_LEVEL=debug

# DATABASE_HOST is intentionally unset: configure.swift falls back to localhost for local
# runs, and the container recipes inject `insights-db.test` themselves.
DATABASE_PORT=5432
DATABASE_NAME=vapor_database
DATABASE_USERNAME=vapor_username
DATABASE_PASSWORD=vapor_password

# Sync jobs resolve platform tokens from Tapis Vault. Missing values abort boot.
TAPIS_BASE_URL=https://icicle.tapis.io
TAPIS_TOKEN=
TAPIS_USER=
TAPIS_TENANT=icicle
