# Non-secret settings shared by application containers in the local stack.
# Loaded after .env so deployment database/cache values cannot leak into local services.

LOG_LEVEL=info

# Read by every process in the stack, so all of them agree. Previously only `serve` was told its
# environment, through a --env flag on its command; the worker, scheduler, and migrator fell
# through to Vapor's default of development, so one stack held processes that disagreed about
# which environment they were in.
#
# development, because this stack is local tooling: the ICICLE seed migration registers only in
# development, so a fresh volume still comes up with a populated dashboard. Deployments set
# VAPOR_ENV=production in their own environment instead.
VAPOR_ENV=development

DATABASE_PORT=5432
DATABASE_NAME=vapor_database
DATABASE_USERNAME=vapor_username
DATABASE_PASSWORD=vapor_password
DATABASE_TLS=disable

REDIS_PORT=6379
REDIS_PASSWORD=
